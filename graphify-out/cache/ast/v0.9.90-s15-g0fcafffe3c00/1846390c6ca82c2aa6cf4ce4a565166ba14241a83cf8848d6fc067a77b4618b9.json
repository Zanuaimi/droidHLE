e(&value) {}\n  FMT_CONSTEXPR scan_arg(unsigned& value)\n      : type(scan_type::uint_type), uint_value(&value) {}\n  FMT_CONSTEXPR scan_arg(long long& value)\n      : type(scan_type::long_long_type), long_long_value(&value) {}\n  FMT_CONSTEXPR scan_arg(unsigned long long& value)\n      : type(scan_type::ulong_long_type), ulong_long_value(&value) {}\n  FMT_CONSTEXPR scan_arg(std::string& value)\n      : type(scan_type::string_type), string(&value) {}\n  FMT_CONSTEXPR scan_arg(fmt::string_view& value)\n      : type(scan_type::string_view_type), string_view(&value) {}\n  template <typename T>\n  FMT_CONSTEXPR scan_arg(T& value) : type(scan_type::custom_type()", "file_type": "code", "source_file": "third_party/dynarmic/externals/fmt/test/scan.h", "source_location": "L14", "_callable": true}, {"id": "fmt_begin_namespace", "label": "FMT_BEGIN_NAMESPACE", "file_type": "code", "source_file": "", "source_location": "", "origin_file": "$graphify-root$/third_party/dynarmic/externals/fmt/test/scan.h"}, {"id": "$graphify-root$_third_party_dynarmic_externals_fmt_test_scan_scan_custom_arg", "label": "scan_custom_arg()", "file_type": "code", "source_file": "third_party/dynarmic/externals/fmt/test/scan.h", "source_location": "L105", "_callable": true}, {"id": "private", "label": "private", "file_type": "code", "source_file": "", "source_location": "", "origin_file": "$graphify-root$/third_party/dynarmic/externals/fmt/test/scan.h"}, {"id": "scan_parse_context", "label": "scan_parse_context", "file_type": "code", "source_file": "", "source_location": "", "origin_file": "$graphify-root$/third_party/dynarmic/externals/fmt/test/scan.h"}, {"id": "scan_context", "label": "scan_context", "file_type": "code", "source_file": "", "source_location": "", "origin_file": "$graphify-root$/third_party/dynarmic/externals/fmt/test/scan.h"}, {"id": "$graphify-root$_third_party_dynarmic_externals_fmt_test_scan_scan_args", "label": "scan_args", "file_type": "code", "source_file": "third_party/dynarmic/e